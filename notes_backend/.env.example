# Backend configuration
# NOTE: Do not commit real secrets. This is a template.

# Comma-separated list of allowed frontend origins for CORS.
# Example:
# FRONTEND_ORIGINS=http://localhost:3000,https://my-frontend.example.com
FRONTEND_ORIGINS=http://localhost:3000

# Database configuration:
# Prefer providing a full SQLAlchemy URL via DATABASE_URL.
# If DATABASE_URL is not set, the backend will build it from POSTGRES_* vars.
#
# Example (matches notes_database/db_connection.txt):
# DATABASE_URL=postgresql+psycopg2://appuser:dbuser123@localhost:5000/myapp
DATABASE_URL=

POSTGRES_URL=localhost
POSTGRES_PORT=5000
POSTGRES_USER=appuser
POSTGRES_PASSWORD=dbuser123
POSTGRES_DB=myapp

# Optional: default pagination
DEFAULT_PAGE_SIZE=50
MAX_PAGE_SIZE=200
